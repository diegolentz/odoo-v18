<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- A1 grafico confirmados -->
        <record id="action_dashboard_confirma_graph" model="ir.actions.act_window">
            <field name="name">Confirmados - Grafico</field>
            <field name="res_model">legos18.crm.confirma.report</field>
            <field name="view_mode">graph</field>
        </record>

        <!-- A2 Pivot Confirmados -->
        <record id="action_dashboard_confirma_pivot" model="ir.actions.act_window">
            <field name="name">Confirmados - Pivot</field>
            <field name="res_model">legos18.crm.confirma.report</field>
            <field name="view_mode">pivot</field>
        </record>

        <!-- A3 Leads por etapa -->
        <record id="action_dashboard_leads_etapa" model="ir.actions.act_window">
            <field name="name">Leads por Etapa </field>
            <field name="res_model">crm.lead</field>
            <field name="view_mode">graph</field>
            <field name="context">{'group_by': 'stage_id'}</field>
        </record>

        <!-- A4 Actividades pendientes -->
        <record id="action_dashboard_actividades" model="ir.actions.act_window">
            <field name="name">Actividades Pendientes</field>
            <field name="res_model">mail.activity</field>
            <field name="view_mode">list</field>
            <field name="domain">[('date_deadline', '&lt;=', context_today().strftime('%Y-%m-%d'))]</field>
        </record>


        <!-- Menú top-level (aparece como app en el home) -->
        <record id="action_custom_dashboard" model="ir.actions.client">
            <field name="name">Mi Dashboard</field>
            <field name="tag">custom_dashboard.Dashboard</field>
        </record>

        <menuitem id="menu_custom_dashboard"
            name="Mi Dashboard"
            action="action_custom_dashboard"
            sequence="1" />

    </data>
</odoo>