<odoo>
    <data>
        <template id="sign_page_template" name="Página de Firma">
            <html>
                <head>
                    <meta charset="UTF-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                    <title>Firmar documento</title>
                    <link rel="stylesheet" href="/custom_pdf_link/static/src/css/sign_page.css"/>
                </head>
                <body>
                    <div class="header">
                        <!-- <span style="font-size:22px;">✍️</span> -->
                        <h1>Firma de documento</h1>
                    </div>
                    <div class="container">
                        <t t-if="sign_req.state == 'signed'">
                            <div class="card">
                                <div class="signed-box">
                                    <div class="icon">✅</div>
                                    <h2>Documento ya firmado</h2>
                                    <p>Este documento fue firmado el <t t-esc="sign_req.signed_date"/>.</p>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="card">
                                <div class="card-title">📄 Documento a firmar: <t t-esc="sign_req.attachment_id.name"/></div>
                                <iframe class="pdf-frame" t-att-src="pdf_url + '&amp;inline=true'"/>
                            </div>
                            <div class="card" id="firmaCard">
                                <div class="card-title">Tu firma</div>
                                <div class="sign-area">
                                    <p class="sign-label">Dibujá tu firma en el recuadro de abajo con el dedo o el mouse:</p>
                                    <canvas id="signCanvas" height="200"/>
                                    <div class="btn-row">
                                        <button class="btn btn-clear" onclick="clearFirma()">Limpiar</button>
                                        <button class="btn btn-submit" id="btnSubmit" onclick="submitSignature()">Confirmar firma</button>
                                    </div>
                                </div>
                            </div>
                            <div class="card" id="aclaracionCard" style="display:none">
                                <div class="card-title">Tu aclaración</div>
                                <div class="sign-area">
                                    <p class="sign-label">Dibujá tu aclaración (nombre y apellido) en el recuadro de abajo:</p>
                                    <canvas id="aclaracionCanvas" height="200"/>
                                    <div class="btn-row">
                                        <button class="btn btn-clear" onclick="clearAclaracion()">Limpiar</button>
                                        <button class="btn btn-submit" id="btnAclaracion" onclick="submitAclaracion()">Confirmar aclaración</button>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <div id="successBox" class="card" style="display:none">
                            <div class="signed-box">
                                <div class="icon">🎉</div>
                                <h2>¡Firma enviada con éxito!</h2>
                                <p>El documento quedó firmado. Podés cerrar esta ventana.</p>
                            </div>
                        </div>
                    </div>
                    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"/>
                    <script>
                        window.SIGN_TOKEN = '<t t-esc="token"/>';
                    </script>
                    <script src="/custom_pdf_link/static/src/js/sign_page.js"/>
                </body>
            </html>
        </template>
    </data>
</odoo>
