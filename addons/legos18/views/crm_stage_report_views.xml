<odoo>
<data>

<!--  lista -->
<record id="view_legos18_crm_confirma_report_list" model="ir.ui.view">
    <field name="name">legos18.crm.confirma.report.list</field>
    <field name="model">legos18.crm.confirma.report</field>
    <field name="arch" type="xml">
        <list string="Pasos por Confirmado" js_class="legos18_confirma_list">
            <field name="lead_id"/>
            <field name="partner_id"/>
            <field name="user_id"/>
            <field name="referido"/>
            <field name="source_id"/>
            <field name="fecha_entrada"/>
            <field name="priority"/>
            <field name="active"/>
        </list>
    </field>
</record>

<!-- pivot -->
<record id="view_legos18_crm_confirma_report_pivot" model="ir.ui.view">
    <field name="name">legos18.crm.confirma.report.pivot</field>
    <field name="model">legos18.crm.confirma.report</field>
    <field name="arch" type="xml">
        <pivot string="Pasos por Confirmado">
            <field name="fecha_entrada" interval="month" type="row"/>
            <field name="priority" type="col"/>
        </pivot>
    </field>
</record>

<!-- graph confirmados (usado por dashboard - incluye campos groupables) -->
<record id="view_legos18_crm_confirma_report_graph" model="ir.ui.view">
    <field name="name">legos18.crm.confirma.report.graph</field>
    <field name="model">legos18.crm.confirma.report</field>
    <field name="arch" type="xml">
        <graph string="Pasos por Confirmado" type="bar">
            <field name="user_id" type="row"/>
            <field name="source_id"/>
            <field name="referido"/>
            <field name="priority"/>
            <field name="fecha_entrada" interval="month"/>
        </graph>
    </field>
</record>

<!-- search -->
<record id="view_legos18_crm_confirma_report_search" model="ir.ui.view">
    <field name="name">legos18.crm.confirma.report.search</field>
    <field name="model">legos18.crm.confirma.report</field>
    <field name="arch" type="xml">
        <search string="Buscar">
            <field name="user_id"/>
            <field name="referido"/>
            <field name="source_id"/>
            <field name="priority"/>
            <filter string="Fecha de entrada" name="filter_fecha_entrada" date="fecha_entrada"/>
            <separator/>
            <filter string="Perdidos" name="filter_perdidos" domain="[('active', '=', False)]"/>
            <separator/>
            <filter string="Leve" name="filter_prioridad_leve" domain="[('priority', '=', '1')]"/>
            <filter string="Medio" name="filter_prioridad_medio" domain="[('priority', '=', '2')]"/>
            <filter string="Grave" name="filter_prioridad_grave" domain="[('priority', '=', '3')]"/>
            <group expand="0" string="Agrupar por">
                <filter string="Mes" name="group_month" context="{'group_by': 'fecha_entrada:month'}"/>
                <filter string="Comercial" name="group_user" context="{'group_by': 'user_id'}"/>
                <filter string="Referido" name="group_referido" context="{'group_by': 'referido'}"/>
                <filter string="Origen" name="group_origen" context="{'group_by': 'source_id'}"/>
                <filter string="Prioridad" name="group_prioridad" context="{'group_by': 'priority'}"/>
            </group>
        </search>
    </field>
</record>

<!-- accion, 6 meses default -->
<record id="action_legos18_crm_confirma_report" model="ir.actions.act_window">
    <field name="name">Informe Custom</field>
    <field name="res_model">legos18.crm.confirma.report</field>
    <field name="view_mode">graph,pivot,list</field>
    <field name="search_view_id" ref="view_legos18_crm_confirma_report_search"/>
    <field name="domain">[('fecha_entrada', '&gt;=', (context_today() - relativedelta(months=6)).strftime('%Y-%m-01'))]</field>
</record>

<!-- item custom menu -->
<menuitem id="menu_legos18_crm_confirma_report"
    name="Informe Custom"
    parent="crm.crm_menu_report"
    action="action_legos18_crm_confirma_report"
    sequence="10"/>

<!-- graph movimientos de etapa (equipo ingreso / cierre) -->
<record id="view_legos18_crm_stage_mov_graph" model="ir.ui.view">
    <field name="name">legos18.crm.stage.mov.graph</field>
    <field name="model">legos18.crm.stage.mov</field>
    <field name="arch" type="xml">
        <graph string="Movimientos de Etapa" type="bar">
            <field name="stage_to_name" type="row"/>
        </graph>
    </field>
</record>

</data>
</odoo>