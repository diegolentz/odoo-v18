<odoo>
    <data>
        <record id="view_crm_lead_form_custom" model="ir.ui.view">
            <field name="name">crm.lead.form.custom</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//group[@name='opportunity_partner']" position="before">
                    <field name="priority_custom" widget="priority" invisible="type == 'lead'"/>
                </xpath>
       
                
                <xpath expr="//field[@name='user_id']" position="before">
                    <field name="contact_name"/>
                    <field name="celular"/>
                    <button name="cel_wpp_calc" string="Contactar" type="object" class="oe_stat_button" icon="fa-whatsapp"/>
                    <button name="mobile_whatsapp_consulta" type="object" class="oe_stat_button" icon="fa-whatsapp"/>
                    <field name="celular_secundario"/>
                    <field name="edad"/>
                    <field name="grado_lesion"/>
                    <field name="ingreso_base"/>
                    <field name="ingreso_bruto"/>
                    <field name="fuero"/>
                    <field name="fecha_accidente"/>
                    <field name="tipo_accidente"/>
                    <field name="fractura"/>
                    <field name="observaciones"/>
                    <field name="prestadora"/>
                    <field name="tipo_lesion"/>
                    <field name="junta_medica"/>
                    <field name="audiencia_medica"/>
                    <field name="instancia_judicial"/>
                    <field name="prioridad_automatica" widget="priority"/>
                    <field name="coeficiente_actualizacion"/>
                    <field name="celular_alternativo"/>
                    <field name="telefono_secundario"/>
                    <field name="telefono_alternativo"/>
                    <field name="dni"/>
                    <field name="relato_hechos"/>
                    <field name="comision_medica"/>
                    <field name="diagnostico_contingencia"/>
                    <field name="datos_empleador"/>
                    <field name="cuit"/>
                    <field name="razon_social"/>
                    <field name="domicilio_empleador"/>
                    <field name="domicilio_trabajador"/>
                </xpath>

                <xpath expr="//div[@class='o_lead_opportunity_form_inline_fields']/field[@name='priority']" position="replace"/>

            </field>
        </record>

        <record id="view_crm_case_leads_filter_custom" model="ir.ui.view">
            <field name="name">crm.lead.search.leads.custom</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lead_properties']" position="after">
                    <field name="prioridad_automatica" string="Prioridad Automática"/>
                    <field name="priority_custom" string="Prioridad Caso"/>
                </xpath>
                <xpath expr="//filter[@name='group_by_lead_properties']" position="after">
                    <filter string="Prioridad Automática" name="group_by_prioridad_automatica" context="{'group_by': 'prioridad_automatica'}"/>
                    <filter string="Prioridad Caso" name="group_by_priority_custom" context="{'group_by': 'priority_custom'}"/>
                </xpath>
            </field>
        </record>

        <record id="view_crm_case_opportunities_filter_custom" model="ir.ui.view">
            <field name="name">crm.lead.search.opportunities.custom</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lead_properties']" position="after">
                    <field name="prioridad_automatica" string="Prioridad Automática"/>
                    <field name="priority_custom" string="Prioridad Caso"/>
                </xpath>
                <xpath expr="//filter[@name='group_by_lead_properties']" position="after">
                    <filter string="Prioridad Automática" name="group_by_prioridad_automatica" context="{'group_by': 'prioridad_automatica'}"/>
                    <filter string="Prioridad Caso" name="group_by_priority_custom" context="{'group_by': 'priority_custom'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
